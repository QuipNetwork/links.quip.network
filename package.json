{
  "name": "quip-linktree",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 8888",
    "build:client": "vite build",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir build-ssr",
    "prerender": "node prerender.mjs",
    "build": "tsc && bun run build:client && bun run build:server && bun run prerender",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "check": "tsc -b"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@typescript-eslint/eslint-plugin": "^7",
    "@typescript-eslint/parser": "^7",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.14",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vite": "^5.4.11"
  }
}
